#include "lcd_i2c.h"
#include "driver/i2c_master.h"
#include "esp_log.h"

#include "freertos/FreeRTOS.h"
#include "freertos/task.h"

#define SDA_PIN 21
#define SCL_PIN 22

void app_main(void)
{
    i2c_master_bus_config_t bus_config = {
        .i2c_port = I2C_NUM_0,
        .sda_io_num = SDA_PIN,
        .scl_io_num = SCL_PIN,
        .clk_source = I2C_CLK_SRC_DEFAULT,
        .glitch_ignore_cnt = 7,
        .flags.enable_internal_pullup = true,
    };

    i2c_master_bus_handle_t bus;

    ESP_ERROR_CHECK(
        i2c_new_master_bus(
            &bus_config,
            &bus));

    ESP_ERROR_CHECK(
        lcd_init(bus));



    lcd_clear();
    lcd_clear();

const char *msg = "Hola GER";

while (1)
{
    for (int pos = 32; pos >= 0; pos--)
    {
        lcd_set_cursor(0,0);
        lcd_print("                ");

        lcd_set_cursor(pos,0);
        lcd_print("Hola GER son las 02:40 de la madrugada");

        vTaskDelay(pdMS_TO_TICKS(300));
    }
}
}
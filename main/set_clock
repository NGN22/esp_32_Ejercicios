#define RTC_RST_GPIO GPIO_NUM_33
#define RTC_DAT_GPIO GPIO_NUM_32
#define RTC_CLK_GPIO GPIO_NUM_14

/*prototipos*/
static void ds1302_write_register(uint8_t reg, uint8_t value);
static uint8_t ds1302_read_register(uint8_t reg);
static void ds1302_set_time(uint8_t hour, uint8_t min, uint8_t sec);




static const char *TAG = "DS1302";

/* ========= Funciones básicas ========= */

static void ds1302_delay(void)
{
    ets_delay_us(2);
}

/**/
static uint8_t dec_to_bcd(uint8_t dec)
{
    return ((dec / 10) << 4) | (dec % 10);
}

static void ds1302_set_datetime(uint8_t year,
                                uint8_t month,
                                uint8_t date,
                                uint8_t day_of_week,
                                uint8_t hour,
                                uint8_t min,
                                uint8_t sec)
{
    /* Deshabilitar protección de escritura */
    ds1302_write_register(0x8E, 0x00);

    /* Hora y fecha */
    ds1302_write_register(0x80, dec_to_bcd(sec) & 0x7F);
    ds1302_write_register(0x82, dec_to_bcd(min));
    ds1302_write_register(0x84, dec_to_bcd(hour));

    ds1302_write_register(0x86, dec_to_bcd(date));
    ds1302_write_register(0x88, dec_to_bcd(month));
    ds1302_write_register(0x8A, dec_to_bcd(day_of_week));
    ds1302_write_register(0x8C, dec_to_bcd(year));

    /* Opcional: volver a proteger */
    ds1302_write_register(0x8E, 0x80);
}


static void ds1302_set_time(uint8_t hour,
                            uint8_t min,
                            uint8_t sec)
{
    ds1302_write_register(0x8E, 0x00); // quitar write protect

    ds1302_write_register(0x80, dec_to_bcd(sec));
    ds1302_write_register(0x82, dec_to_bcd(min));
    ds1302_write_register(0x84, dec_to_bcd(hour));
}



static void ds1302_write_byte(uint8_t data)
{
    gpio_set_direction(RTC_DAT_GPIO, GPIO_MODE_OUTPUT);

    for (int i = 0; i < 8; i++)
    {
        gpio_set_level(RTC_DAT_GPIO, (data >> i) & 0x01);

        gpio_set_level(RTC_CLK_GPIO, 1);
        ds1302_delay();

        gpio_set_level(RTC_CLK_GPIO, 0);
        ds1302_delay();
    }
}

static uint8_t ds1302_read_byte(void)
{
    uint8_t data = 0;

    gpio_set_direction(RTC_DAT_GPIO, GPIO_MODE_INPUT);

    for (int i = 0; i < 8; i++)
    {
        if (gpio_get_level(RTC_DAT_GPIO))
        {
            data |= (1 << i);
        }

        gpio_set_level(RTC_CLK_GPIO, 1);
        ds1302_delay();

        gpio_set_level(RTC_CLK_GPIO, 0);
        ds1302_delay();
    }

    return data;
}

static void ds1302_write_register(uint8_t reg, uint8_t value)
{
    gpio_set_level(RTC_RST_GPIO, 1);

    ds1302_write_byte(reg);
    ds1302_write_byte(value);

    gpio_set_level(RTC_RST_GPIO, 0);
}

static uint8_t ds1302_read_register(uint8_t reg)
{
    uint8_t value;

    gpio_set_level(RTC_RST_GPIO, 1);

    ds1302_write_byte(reg | 0x01);

    value = ds1302_read_byte();

    gpio_set_level(RTC_RST_GPIO, 0);

    return value;
}

/* ========= Utilidades ========= */

static uint8_t bcd_to_dec(uint8_t bcd)
{
    return ((bcd >> 4) * 10) + (bcd & 0x0F);
}

static void ds1302_init(void)
{
    gpio_config_t io_conf = {
        .mode = GPIO_MODE_OUTPUT,
        .pin_bit_mask =
            (1ULL << RTC_RST_GPIO) |
            (1ULL << RTC_CLK_GPIO)
    };

    gpio_config(&io_conf);

    gpio_set_level(RTC_RST_GPIO, 0);
    gpio_set_level(RTC_CLK_GPIO, 0);

    /*
     * Deshabilitar write-protect
     * Registro 0x8E
     */
    ds1302_write_register(0x8E, 0x00);
}

static void ds1302_read_datetime(void)
{
    uint8_t sec   = bcd_to_dec(ds1302_read_register(0x81) & 0x7F);
    uint8_t min   = bcd_to_dec(ds1302_read_register(0x83));
    uint8_t hour  = bcd_to_dec(ds1302_read_register(0x85));

    uint8_t date  = bcd_to_dec(ds1302_read_register(0x87));
    uint8_t month = bcd_to_dec(ds1302_read_register(0x89));
    uint8_t day   = bcd_to_dec(ds1302_read_register(0x8B));
    uint8_t year  = bcd_to_dec(ds1302_read_register(0x8D));

    ESP_LOGI(TAG,
             "%02d/%02d/20%02d - %02d:%02d:%02d (DOW=%d)",
             date,
             month,
             year,
             hour,
             min,
             sec,
             day);
}


/*control remoto infrerojo solo */


#include <stdio.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"

#include "driver/gpio.h"
#include "esp_log.h"

#define IR_GPIO GPIO_NUM_23

static const char *TAG = "IR_TEST";

void app_main(void)
{
    gpio_config_t io_conf = {
        .pin_bit_mask = (1ULL << IR_GPIO),
        .mode = GPIO_MODE_INPUT,
        .pull_up_en = GPIO_PULLUP_ENABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_DISABLE
    };

    gpio_config(&io_conf);

    ESP_LOGI(TAG, "Prueba receptor IR en GPIO23");

    int estado_anterior = gpio_get_level(IR_GPIO);

    while (1)
    {
        int estado_actual = gpio_get_level(IR_GPIO);

        if (estado_actual != estado_anterior)
        {
            ESP_LOGI(TAG,
                     "Cambio detectado -> %d",
                     estado_actual);

            estado_anterior = estado_actual;
        }

        vTaskDelay(pdMS_TO_TICKS(1));
    }
}